# ==============================================
# PalmChain Client Environment Configuration (.env.example)
# Note: Keep placeholders only. Do not commit actual secrets.
# ==============================================

# Backend API Endpoint
VITE_API_URL=http://localhost:5000/api

# Supabase Public Configuration (PUBLISHABLE / ANON KEY ONLY - NEVER PUT SERVICE ROLE KEY HERE!)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Ethereum Blockchain Configuration (Sepolia Testnet)
VITE_SEPOLIA_CHAIN_ID=11155111
VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
VITE_PALMCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
